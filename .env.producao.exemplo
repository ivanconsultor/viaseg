# Credenciais de FTP da HOSTINGER para o envio automatico do site.
#
# COMO USAR
#   1. Copie este arquivo para  .env.production
#   2. Preencha com os dados do hPanel em: Arquivos -> Contas FTP
#   3. NUNCA versione o arquivo preenchido. O .gitignore ja bloqueia .env*
#
# ATENCAO: o arquivo antigo continha credenciais da HostGator, hospedagem
# anterior. Foi movido para _OBSOLETOS. Nao reaproveite aqueles dados: o envio
# iria para o servidor errado.

FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_DIR=public_html

# Use conexao criptografada sempre que o plano permitir (o hPanel informa).
# true  = FTPS, senha protegida (recomendado)
# false = FTP puro, senha trafega em texto legivel
FTP_TLS=true
