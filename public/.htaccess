# ViaSeg Corretora - configuracao do Apache/LiteSpeed na Hostinger
# Este arquivo e copiado para out/ durante o build e vai para public_html.

RewriteEngine On

# 1. Forcar HTTPS (SSL)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Forcar www (endereco oficial do site)
#    Sem isto o site responde em viasegcorretora.com.br E em www.viasegcorretora.com.br
#    com o mesmo conteudo. Para o Google isso e conteudo duplicado: ele divide a
#    autoridade entre os dois enderecos e nenhum posiciona bem.
#    O sitemap, o JSON-LD e os metadados usam www, entao www e o oficial.
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} !^$
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# 3. URLs amigaveis do Next.js estatico (ex: /cotacao -> /cotacao.html)
#
#    ARMADILHA: o build gera cotacao.html E TAMBEM uma pasta cotacao/ com os
#    arquivos internos de navegacao. Ao ver a pasta, o Apache redireciona
#    /cotacao para /cotacao/, que nao tem indice -> 403 Forbidden.
#
#    DirectorySlash Off impede esse redirecionamento automatico, e a regra
#    abaixo NAO pode ter a condicao !-d: e justamente quando existe pasta com
#    o mesmo nome que precisamos servir o .html.
DirectorySlash Off
Options -Indexes

#    /sobre -> sobre.html  (quando nao existe arquivo com esse nome exato)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

#    /sobre/ -> sobre.html  (visitante que digitou a barra no final)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1.html [L]

# 4. Pagina 404 personalizada
ErrorDocument 404 /404.html

# 5. Cabecalhos de seguranca
#    IMPORTANTE: no modo de exportacao estatica (output: 'export') o Next.js
#    ignora a funcao headers() do next.config.ts. Estes cabecalhos so existem
#    porque estao declarados aqui.
<IfModule mod_headers.c>
    # --- CSP: SITE SEM RASTREAMENTO (DESATIVADA) ---------------------------
    # Guardada para emergencia: se algum dia o rastreamento sair do site,
    # reative esta e comente a de baixo. Ela e mais restritiva.
    #Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://images.unsplash.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

    # --- CSP: SITE COM RASTREAMENTO (ATIVA) --------------------------------
    # Esta e a regra em vigor. Ela libera os dominios de medicao. Sem ela,
    # GTM, GA4, Google Ads, Pixel e Stape sao BLOQUEADOS em silencio: nao
    # aparece erro nenhum na tela, simplesmente nao registra nada.
    #
    # Contas configuradas:
    #   GTM        GTM-K8MXPGMJ
    #   GA4        G-WWDS8CMG8P
    #   Google Ads AW-17845467917
    #   Stape      server.viasegcorretora.com.br
    #
    # Dominios liberados e por que:
    #   server.viasegcorretora.com.br   contorno Stape (server-side GTM)
    #   www.googletagmanager.com        script do GTM e do GA4
    #   www.google-analytics.com        envio de dados do GA4
    #   analytics.google.com            envio de dados do GA4 (rota nova)
    #   www.googleadservices.com        conversoes do Google Ads
    #   googleads.g.doubleclick.net     remarketing do Google Ads
    #   td.doubleclick.net              medicao do Google Ads
    #   www.google.com / .com.br        pixel de conversao do Google Ads
    #   connect.facebook.net            Pixel do Facebook
    #   www.facebook.com                imagem de fallback do Pixel
    #
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://server.viasegcorretora.com.br https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://images.unsplash.com https://server.viasegcorretora.com.br https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://td.doubleclick.net https://www.google.com https://www.google.com.br https://www.facebook.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://server.viasegcorretora.com.br https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://td.doubleclick.net https://connect.facebook.net; frame-src https://www.googletagmanager.com https://td.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"


    # Demais cabecalhos de seguranca.
    # Foram perdidos numa edicao anterior e so o CSP ficou no ar - conferir a
    # resposta real do servidor depois de mexer aqui, nao confiar no arquivo.
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

</IfModule>

# 6. Bloquear acesso a arquivos sensiveis
<FilesMatch "^\.(env|git|htaccess)|\.(env|log|bak|sql|zip)$">
    Require all denied
</FilesMatch>

# 7. Cache de arquivos estaticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
